{
  "pluginAlias": "AlexaSmartHomePlus",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./homebridge-ui",
  "headerDisplay": "<h3>Alexa Smart Home Plus</h3><p>Amazon認証、公開する機器、定型アクションを順番に設定します。通常は詳細設定を変更する必要はありません。</p>",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "default": "AlexaSmartHomePlus",
        "condition": {
          "functionBody": "return false;"
        }
      },
      "uiLanguage": {
        "title": "Settings language",
        "type": "string",
        "default": "auto",
        "oneOf": [
          { "title": "Automatic", "enum": ["auto"] },
          { "title": "日本語", "enum": ["ja"] },
          { "title": "English", "enum": ["en"] }
        ]
      },
      "deviceFilterMode": {
        "title": "公開する機器",
        "description": "すべて公開するか、機器名で絞り込むかを選択します。",
        "type": "string",
        "default": "all",
        "oneOf": [
          { "title": "対応機器をすべて公開", "enum": ["all"] },
          { "title": "指定した機器だけ公開", "enum": ["include"] },
          { "title": "指定した機器を除外", "enum": ["exclude"] }
        ]
      },
      "devices": {
        "title": "Include device names",
        "description": "List of smart home device names to add as HomeKit accessories. If no devices are specified, the plugin will attempt to add all supported accessories.",
        "type": "array",
        "uniqueItems": true,
        "default": [],
        "condition": {
          "functionBody": "return model.deviceFilterMode === 'include';"
        },
        "items": {
          "title": "Device name",
          "type": "string"
        }
      },
      "deviceIds": {
        "title": "Selected Alexa device IDs",
        "description": "Managed automatically by the custom settings UI to distinguish devices with identical names.",
        "type": "array",
        "uniqueItems": true,
        "default": [],
        "condition": {
          "functionBody": "return false;"
        },
        "items": {
          "type": "string"
        }
      },
      "excludeDevices": {
        "title": "Exclude devices",
        "description": "List of smart home device names to exclude from being added as HomeKit accessories. Exclude devices will only be excluded if 'Include device names' is empty.",
        "type": "array",
        "uniqueItems": true,
        "default": [],
        "condition": {
          "functionBody": "return model.deviceFilterMode === 'exclude';"
        },
        "items": {
          "title": "Device name",
          "type": "string"
        }
      },
      "excludeDeviceIds": {
        "title": "Excluded Alexa device IDs",
        "description": "Managed automatically by the custom settings UI to distinguish devices with identical names.",
        "type": "array",
        "uniqueItems": true,
        "default": [],
        "condition": {
          "functionBody": "return false;"
        },
        "items": {
          "type": "string"
        }
      },
      "deviceAliases": {
        "title": "HomeKit device names",
        "description": "Optionally give Alexa devices different names in HomeKit. Alexa device names must match exactly.",
        "type": "array",
        "default": [],
        "items": {
          "title": "Device name mapping",
          "type": "object",
          "properties": {
            "alexaName": {
              "title": "Alexa device name",
              "type": "string",
              "required": true
            },
            "homeKitName": {
              "title": "HomeKit device name",
              "type": "string",
              "required": true
            }
          }
        }
      },
      "routines": {
        "title": "Alexa routines",
        "description": "Expose selected Alexa routines as momentary HomeKit switches.",
        "type": "object",
        "required": false,
        "properties": {
          "names": {
            "title": "Routine names",
            "description": "Alexa routine names to expose. Names must match exactly. Leave empty to disable routine accessories.",
            "type": "array",
            "uniqueItems": true,
            "default": [],
            "items": {
              "title": "Routine name",
              "type": "string"
            }
          },
          "executionDevice": {
            "title": "Execution Echo device",
            "description": "Optional Echo device name or serial number used as the routine execution context. The first available Echo is used when omitted.",
            "type": "string",
            "required": false
          },
          "resetDelayMs": {
            "title": "Switch reset delay",
            "description": "Return the HomeKit routine switch to OFF after this many milliseconds.",
            "type": "integer",
            "minimum": 100,
            "maximum": 10000,
            "default": 500
          }
        }
      },
      "amazonDomain": {
        "title": "Amazon domain",
        "type": "string",
        "description": "The Amazon domain that your devices are registered to.",
        "required": false,
        "default": "amazon.com",
        "oneOf": [
          { "title": "amazon.com", "enum": ["amazon.com"] },
          { "title": "amazon.ca", "enum": ["amazon.ca"] },
          { "title": "amazon.de", "enum": ["amazon.de"] },
          { "title": "amazon.es", "enum": ["amazon.es"] },
          { "title": "amazon.fr", "enum": ["amazon.fr"] },
          { "title": "amazon.it", "enum": ["amazon.it"] },
          { "title": "amazon.in", "enum": ["amazon.in"] },
          { "title": "amazon.nl", "enum": ["amazon.nl"] },
          { "title": "amazon.co.jp", "enum": ["amazon.co.jp"] },
          { "title": "amazon.co.uk", "enum": ["amazon.co.uk"] },
          { "title": "amazon.com.au", "enum": ["amazon.com.au"] },
          { "title": "amazon.com.br", "enum": ["amazon.com.br"] },
          { "title": "amazon.com.mx", "enum": ["amazon.com.mx"] }
        ]
      },
      "language": {
        "title": "Two character language code hyphen two character country code",
        "description": "Language for Alexa authentication.",
        "type": "string",
        "required": false,
        "default": "en-US"
      },
      "auth": {
        "title": "Authorization and authentication settings",
        "type": "object",
        "required": true,
        "properties": {
          "refreshInterval": {
            "title": "Refresh interval",
            "placeholder": "Refresh the session automatically every __ days",
            "description": "How often this plugin should automatically refresh the session with Amazon. Defaults to every 4 days.",
            "type": "number",
            "required": false,
            "default": 4
          },
          "reauthenticateOnFailure": {
            "title": "Automatically recover Alexa authentication",
            "description": "If Amazon rejects the saved session, discard it and automatically start the browser authentication flow. Amazon may still require MFA or CAPTCHA confirmation.",
            "type": "boolean",
            "required": false,
            "default": true
          },
          "proxy": {
            "title": "Proxy Client Host",
            "type": "object",
            "properties": {
              "clientHost": {
                "title": "Proxy Client Host",
                "placeholder": "e.g., 192.168.1.234, homebridge.local, localhost",
                "description": "A current IP address or hostname of the Homebridge host that is accessible from the web browser where you will authenticate from.",
                "type": "string",
                "required": true
              },
              "port": {
                "title": "Proxy port",
                "placeholder": "e.g., 2345",
                "description": "The port to run the authentication proxy on.",
                "type": "integer",
                "required": true,
                "minimum": 7000,
                "maximum": 9999,
                "default": 9000
              }
            }
          }
        }
      },
      "performance": {
        "title": "Performance",
        "type": "object",
        "required": false,
        "properties": {
          "cacheTTL": {
            "title": "Device state cache lifetime",
            "description": "Refresh Alexa device states every __ seconds. Higher values will allow this plugin to work faster if you are noticing 'This plugin slows down Homebridge' messages in the Homebridge logs. However, higher values also means device states may be less accurate.",
            "type": "integer",
            "required": false,
            "minimum": 30,
            "maximum": 3600,
            "default": 60
          }
        }
      },
      "disabledOperations": {
        "title": "Disable Features",
        "description": "Turn off specific device capabilities",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "deviceName": {
              "title": "Device name",
              "type": "string"
            },
            "operations": {
              "title": "Disabled operations",
              "type": "string",
              "placeholder": "Comma separated list, e.g., setBrightness, setColor, setColorTemperature",
              "pattern": "^(\\w+)(,\\s*\\w+)*$"
            }
          }
        }
      },
      "debug": {
        "title": "Debug logging",
        "description": "Whether to enable debug logging for troubleshooting issues and support.",
        "type": "boolean",
        "required": false,
        "default": false
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "Amazonアカウント",
      "description": "初回認証に必要な設定です。",
      "items": [
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": [
            { "key": "amazonDomain", "flex": "1 1 50%" },
            { "key": "language", "flex": "1 1 50%" }
          ]
        },
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": [
            { "key": "auth.proxy.clientHost", "flex": "1 1 65%" },
            { "key": "auth.proxy.port", "flex": "1 1 35%" }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "HomeKitに表示する機器",
      "description": "通常は「対応機器をすべて公開」のままで利用できます。",
      "expandable": true,
      "expanded": true,
      "items": [
        "deviceFilterMode",
        {
          "key": "devices",
          "type": "array",
          "title": "公開するAlexa機器",
          "buttonText": "機器名を追加",
          "condition": {
            "functionBody": "return model.deviceFilterMode === 'include';"
          },
          "items": [{ "key": "devices[]" }]
        },
        {
          "key": "excludeDevices",
          "type": "array",
          "title": "除外するAlexa機器",
          "buttonText": "機器名を追加",
          "condition": {
            "functionBody": "return model.deviceFilterMode === 'exclude';"
          },
          "items": [{ "key": "excludeDevices[]" }]
        },
        {
          "key": "deviceAliases",
          "type": "array",
          "title": "HomeKitで別名を使用",
          "buttonText": "名前の対応を追加",
          "expandable": true,
          "expanded": false,
          "items": [
            {
              "type": "flex",
              "flex-flow": "row wrap",
              "items": [
                { "key": "deviceAliases[].alexaName", "flex": "1 1 50%" },
                { "key": "deviceAliases[].homeKitName", "flex": "1 1 50%" }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Alexa定型アクション",
      "description": "必要な定型アクションだけHomeKitスイッチとして追加します。",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "key": "routines.names",
          "type": "array",
          "title": "公開する定型アクション",
          "buttonText": "定型アクション名を追加",
          "items": [{ "key": "routines.names[]" }]
        },
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "condition": {
            "functionBody": "return Array.isArray(model.routines?.names) && model.routines.names.length > 0;"
          },
          "items": [
            { "key": "routines.executionDevice", "flex": "1 1 65%" },
            { "key": "routines.resetDelayMs", "flex": "1 1 35%" }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "詳細設定",
      "description": "認証更新、性能、デバッグに関する設定です。",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": [
            { "key": "auth.refreshInterval", "flex": "1 1 50%" },
            { "key": "performance.cacheTTL", "flex": "1 1 50%" }
          ]
        },
        "auth.reauthenticateOnFailure",
        {
          "key": "disabledOperations",
          "type": "array",
          "title": "機器ごとに無効化する機能",
          "buttonText": "無効化設定を追加",
          "expandable": true,
          "expanded": false,
          "items": [
            {
              "type": "flex",
              "flex-flow": "row wrap",
              "items": [
                { "key": "disabledOperations[].deviceName", "flex": "1 1 45%" },
                { "key": "disabledOperations[].operations", "flex": "1 1 55%" }
              ]
            }
          ]
        },
        "debug"
      ]
    }
  ]
}
