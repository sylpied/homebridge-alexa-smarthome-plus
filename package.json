{
  "displayName": "Alexa Smart Home Plus",
  "name": "homebridge-alexa-smarthome-plus",
  "version": "1.0.0",
  "description": "An independently maintained Homebridge plugin for controlling Alexa smart home devices from HomeKit.",
  "license": "MIT",
  "author": "Alexa Smart Home Plus contributors",
  "homepage": "https://github.com/sylpied/homebridge-alexa-smarthome-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylpied/homebridge-alexa-smarthome-plus.git"
  },
  "bugs": {
    "url": "https://github.com/sylpied/homebridge-alexa-smarthome-plus/issues"
  },
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0",
    "node": "^18.0.0 || ^20.0.0 || ^22.0.0 || ^24.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && tsc -p tsconfig.prod.json",
    "format": "prettier --ignore-path .gitignore --write \"src/**/*.ts\"",
    "lint": "eslint src/**.ts --max-warnings=0",
    "pre-commit": "lint-staged",
    "prepublishOnly": "npm run verify",
    "watch": "npm run build && nodemon",
    "test": "jest --verbose --silent=false --runInBand",
    "test-watch": "nodemon --config ./nodemon-test.json",
    "test-ci": "jest --verbose --silent=true --runInBand",
    "verify": "npm test && npm run lint && npm run build",
    "upgrade": "npm-check-updates --target minor --upgrade"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "alexa",
    "echo",
    "smarthome"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.5",
    "alexa-cookie2": "5.0.4",
    "alexa-remote2": "8.0.5",
    "async-mutex": "^0.5.0",
    "extend": "^3.0.2",
    "fp-ts": "^2.16.9",
    "nearest-color": "^0.4.4",
    "ts-pattern": "^4.3.0"
  },
  "overrides": {
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/nearest-color": "^0.4.1",
    "@types/node": "^18.19.86",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "dotenv": "^16.5.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "homebridge": "^1.11.0",
    "homebridge-config-ui-x": "^5.10.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^13.3.0",
    "nodemon": "^2.0.22",
    "npm-check-updates": "^16.14.20",
    "prettier": "^2.8.8",
    "rimraf": "^4.4.1",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
